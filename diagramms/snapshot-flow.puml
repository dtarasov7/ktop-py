@startuml ktop_py_snapshot_flow
title Snapshot Refresh and Metrics Flow

skinparam backgroundColor white
skinparam shadowing false

start
:KtopApp schedules refresh;
if (Refresh already running?) then (yes)
  :Keep rendering last successful snapshot;
  stop
else (no)
  :Start daemon refresh worker;
endif

:KubectlClient loads cluster identity and objects;
:Get nodes, pods, namespaces;
:Get deployments, replicasets, statefulsets,\ndaemonsets, jobs, and cronjobs;
:Get ResourceQuotas, LimitRanges,\nPVs, PVCs, and events;
if (Metrics source) then (prometheus/prom)
  :Scrape configured kubelet/cAdvisor\ncomponents through nodes/proxy;
  :Parse Prometheus text;
  if (Prometheus unavailable and source implicit?) then (yes)
    :Warn and fall back to metrics-server;
    :Read metrics.k8s.io nodes and pods;
    :Parse metrics JSON;
  else (no)
    :Use Prometheus metrics\nor raise explicit-source error;
  endif
elseif (metrics-server)
  :Read metrics.k8s.io nodes and pods;
  :Parse metrics JSON;
else (none)
  :Mark live metrics unavailable;
endif

:When live metrics are fresh,\nrecord history in KubectlClient;
:Build normalized ClusterSnapshot\nfrom objects, metrics, and retained history;
:Resolve workload owner chains\nand CronJob/job data;
:Health uses quotas, limit ranges,\nand scheduler-fit checks;
:Resource Risk and dumps use request fallback\nwhere live usage is unavailable;
:Publish snapshot under lock;
:Header shows loaded, stale, loading, or error state;
stop

@enduml
